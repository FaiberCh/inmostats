# Byte-compiled / cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Raw scraper CSVs are no longer versioned: they live in the private dataset
# fchaparro/inmostats-data on Hugging Face. Only the checkpoints stay in git:
# the GitHub Actions workflow runs on ephemeral runners and relies on git as the
# persistence layer to resume the national scrape across scheduled runs.
data/raw/**/*.csv
data/processed/*.csv
models/*.pkl
models/*.joblib
models/feature_config.json

# Environment variables
.env

# OS / IDE
.DS_Store
.vscode/

# Archivos de trabajo de la skill de diseno (capturas del inspector)
.taste-skill/

# Dataset limpio generado por build_clean_dataset (se publica en Hugging Face, no en git)
data/clean/
